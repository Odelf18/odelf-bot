# Bot / Heroku
FREQTRADE_STRATEGY=OdelfTrend
API_USERNAME=odelf
API_PASSWORD=change-me
JWT_SECRET_KEY=generate-a-long-random-string

# Set automatically on Heroku when you add the Postgres addon:
# DATABASE_URL=postgres://...

# Web / Vercel (dashboard)
FREQTRADE_API_URL=http://localhost:8080
FREQTRADE_API_USERNAME=odelf
FREQTRADE_API_PASSWORD=change-me
# Optional: mock mode when bot is offline
USE_MOCK_DATA=true
